          <text x="430" y="234" font-size="11" fill="#5A6B6B">binds all future work</text>

          <text x="715" y="212" font-size="14" font-weight="700">CONTROLLED ACTION</text>
          <text x="715" y="234" font-size="11" fill="#5A6B6B">access exists only if granted</text>

          <text x="370" y="384" font-size="14" font-weight="700">SPECIALIST AGENTS</text>
