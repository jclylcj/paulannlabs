        </g>

        <g fill="#1A2F3D" font-family="ui-sans-serif, system-ui, sans-serif" text-anchor="middle">
          <text x="430" y="45" font-size="16" font-weight="700">HUMAN OPERATORS</text>
          <text x="430" y="66" font-size="12" fill="#5A6B6B">rulings · corrections · approvals · refusals</text>

          <text x="155" y="212" font-size="14" font-weight="700">ORCHESTRATION</text>
