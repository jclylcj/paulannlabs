---
import Layout from '../../layouts/Layout.astro';

const papers = [
  {
    n: '01',
    href: '/papers/one-conductor-many-instruments/',
    title: 'One Conductor, Many Instruments',
    sub: 'How we run one orchestrating model, outside models commissioned per question, and a separate checker ... with the owner holding every key',
    date: '29 October 2026',
    blurb: 'The seats, the fence between them, and a worked example from our own sites: three outside models scored our home pages, a separate checker tested their claims live, and three of six did not hold up and two held only in part or with different numbers. Plus what failed, and what is still open.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Papers ... Paul Ann Labs",
  "description": "Papers on how we run multi-model AI work on our own projects: the setup, the checks and the failures.",
  "isPartOf": { "@type": "WebSite", "name": "Paul Ann Labs", "url": "https://paulannlabs.com" },
  "hasPart": papers.map(p => ({
    "@type": "TechArticle",
    "headline": p.title,
    "url": `https://paulannlabs.com${p.href}`,
    "datePublished": "2026-10-29"
  }))
};
---
<Layout
  title="Papers - Paul Ann Labs"
  description="Papers on how we run multi-model AI work on our own projects: the setup, the checks and the failures."
  schema={schema}
>
  <article class="mx-auto max-w-3xl px-5 py-20">
    <h1 class="text-4xl font-bold">Papers</h1>
    <p class="mt-5 text-lg text-slate">
      How we work, written from our own projects.
    </p>
    <p class="mt-4 text-slate">
      Each paper takes work we did on our own sites and publishes the reasoning, the checks and the
      failures. Every paper has a section on what failed, because a setup that has only ever worked
      has not been run.
    </p>

    <div class="mt-14 space-y-8">
      {papers.map(p => (
        <a href={p.href}
           class="block rounded-lg border border-navy/10 bg-white p-8 hover:border-fig transition-colors">
          <p class="text-sm font-semibold uppercase tracking-wide text-fig-ink">
            Paper {p.n} &middot; {p.date}
          </p>
          <h2 class="mt-2 text-2xl font-bold">{p.title}</h2>
          <p class="mt-2 text-slate">{p.sub}</p>
          <p class="mt-4 text-slate">{p.blurb}</p>
          <p class="mt-5 text-sm font-semibold text-fig-ink">Read the paper &rarr;</p>
        </a>
      ))}
    </div>

    <div class="mt-16 rounded-lg border border-navy/10 bg-white p-8">
      <h2 class="text-xl font-semibold">What these papers are</h2>
      <p class="mt-3 text-slate">
        They describe our own work, not client deployments. Where we measured something we say how.
        Where we did not measure it we say that, instead of implying a result.
      </p>
    </div>

    <div class="mt-12">
      <p class="text-slate">
        <a href="https://paulannmedia.com/papers/" class="font-semibold text-fig-ink hover:underline">Paul
        Ann Media publishes the other side</a> ... the same work from the brand side, with the founder.
      </p>
    </div>
  </article>
</Layout>
