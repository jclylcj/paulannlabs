---
const links = [
  { href: '/methodology', label: 'Methodology' },
  { href: '/papers', label: 'Papers' },
  { href: '/peppermint', label: 'Peppermint' },
  { href: '/about', label: 'About' },
];
---
<header class="bg-navy text-cream">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="/" aria-label="Paul Ann Labs home" class="flex items-center">
      <img src="/logo.svg" alt="Paul Ann Labs" class="h-14 w-auto" width="1200" height="360" />
    </a>
    <div class="hidden gap-7 text-sm md:flex">
      {links.map(l => (
        <a href={l.href} class="hover:text-fig transition-colors">{l.label}</a>
      ))}
    </div>
    <a href="/#contact"
       class="rounded bg-fig px-4 py-2 text-sm font-semibold text-navy hover:bg-fig-light transition-colors">
      Start Phase One
    </a>
  </nav>
</header>
