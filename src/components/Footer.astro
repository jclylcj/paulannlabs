---
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-navy text-cream">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="text-lg font-bold">Paul Ann <span class="text-fig">Labs</span></p>
        <p class="mt-3 max-w-xs text-sm text-slate">
          AI deployed inside the business itself. We don't replace your systems ...
          we wrap them, and let the wrapper grow.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-fig">Company</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/methodology" class="hover:text-fig">Methodology</a></li>
          <li><a href="/papers" class="hover:text-fig">Papers</a></li>
          <li><a href="/peppermint" class="hover:text-fig">Peppermint</a></li>
          <li><a href="/about" class="hover:text-fig">About</a></li>
          <li><a href="/#contact" class="hover:text-fig">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-fig">Family</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="https://paulannmedia.com" class="hover:text-fig">Paul Ann Media</a></li>
          <li><a href="https://hometimejobs.com" class="hover:text-fig">HomeTimeJobs</a></li>
          <li><span class="text-slate">Trimmie Holdings</span></li>
        </ul>
      </div>
    </div>
    <p class="mt-12 border-t border-white/10 pt-6 text-xs text-slate">
      &copy; {year} Paul Ann Labs - a Trimmie Holdings company.
    </p>
  </div>
</footer>
